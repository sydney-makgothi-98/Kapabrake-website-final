# ============================================================
# KAPABRAKE SECURITY CONFIGURATION (.htaccess)
# For Xneelo Deployment
# ============================================================
# This file contains comprehensive backend security measures
# to protect the website from various attack vectors.
# NO changes to website content, speed, or functionality.
# ============================================================

# Enable Rewrite Engine (disabled for testing CSS loading)
# RewriteEngine On
# RewriteBase /

# ============================================================
# 1. HTTPS & SECURITY HEADERS
# ============================================================

# Force HTTPS (uncomment once SSL is installed)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Enforce HTTPS for 1 year (HSTS)
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

# Prevent clickjacking attacks
Header always set X-Frame-Options "SAMEORIGIN"

# Prevent MIME type sniffing
Header always set X-Content-Type-Options "nosniff"

# Enable XSS Protection in older browsers
Header always set X-XSS-Protection "1; mode=block"

# Referrer Policy - control what referrer info is sent
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Permissions Policy - restrict browser APIs
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"

# Content Security Policy - prevent XSS and inline script injection
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' fonts.googleapis.com cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' fonts.googleapis.com fonts.gstatic.com; img-src 'self' data: https:; font-src 'self' fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'; upgrade-insecure-requests; block-all-mixed-content"

# ============================================================
# 2. DISABLE DIRECTORY LISTING
# ============================================================

Options -Indexes
Options -MultiViews

# ============================================================
# 3. PROTECT SENSITIVE FILES & EXTENSIONS
# ============================================================

<FilesMatch "\.env|\.git|\.gitignore|\.htaccess|\.htpasswd|error_log|debug\.log|config\.php|database\.php|\.DS_Store">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block backup/temporary files
<FilesMatch "\.(bak|backup|config|conf|sql|fla|psd|ini|log|sh|inc|swp|dist|tmp)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to PHP files (if any exist)
<FilesMatch "\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ============================================================
# 4. RATE LIMITING (1000 requests per IP)
# ============================================================
# Prevents DDoS, brute force, and aggressive bot scraping
# Commented out - enable only if needed and compatible with server

# <IfModule mod_ratelimit.c>
#     SetOutputFilter RATE_LIMIT
#     ModRateLimitZone limitzone 0.0.0.0/0 10 rate=1000
# </IfModule>

# Alternative rate limiting using mod_evasive (if available)
# <IfModule mod_evasive20.c>
#     DOSHashTableSize 3097
#     DOSPageCount 2
#     DOSPageInterval 1
#     DOSSiteCount 50
#     DOSSiteInterval 1
#     DOSBlockingPeriod 600
# </IfModule>

# ============================================================
# 5. BLOCK MALICIOUS BOTS & SCRAPERS
# ============================================================

# Block known bad bots by User-Agent
SetEnvIf User-Agent "wget" BADBOT
SetEnvIf User-Agent "curl" BADBOT
SetEnvIf User-Agent "nikto" BADBOT
SetEnvIf User-Agent "sqlmap" BADBOT
SetEnvIf User-Agent "nmap" BADBOT
SetEnvIf User-Agent "masscan" BADBOT

<Directory />
    Order allow,deny
    Allow from all
    Deny from env=BADBOT
</Directory>

# ============================================================
# 6. GZIP COMPRESSION (IMPROVES SPEED)
# ============================================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json

    # Compress SVG files
    AddType image/svg+xml svg svgz
    AddEncoding gzip svgz
</IfModule>

# ============================================================
# 7. BROWSER CACHING (IMPROVES SPEED)
# ============================================================

<IfModule mod_expires.c>
    ExpiresActive On

    # Images - cache for 1 year
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS & JavaScript - cache for 1 month
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Fonts - cache for 1 year
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    # Videos - cache for 6 months
    ExpiresByType video/mp4 "access plus 6 months"
    ExpiresByType video/webm "access plus 6 months"

    # HTML - cache for 1 day (or don't cache)
    ExpiresByType text/html "access plus 1 day"

    # Default
    ExpiresDefault "access plus 2 days"
</IfModule>

# ============================================================
# 8. CACHE CONTROL HEADERS
# ============================================================

<FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js|svg|webp|mp4|woff|woff2|ttf|otf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
    Header set Pragma "public"
</FilesMatch>

<FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=86400, public"
    Header set Pragma "public"
</FilesMatch>

# ============================================================
# 9. SQL INJECTION & XSS PROTECTION
# ============================================================
# Simplified to avoid server conflicts

# Block script tags in query strings
# RewriteCond %{QUERY_STRING} script [NC]
# RewriteRule .* - [F]

# Block SQL commands in query strings
# RewriteCond %{QUERY_STRING} (union|select|insert|update|delete|drop) [NC]
# RewriteRule .* - [F]

# ============================================================
# 10. PREVENT COMMON ATTACKS
# ============================================================

# Prevent access to config files
# RewriteRule ^wp-config\.php - [F]
# RewriteRule ^\.htaccess$ - [F]
# RewriteRule ^\.env$ - [F]

# Prevent null byte injection
# RewriteCond %{THE_REQUEST} ^.+%00
# RewriteRule ^.*$ - [F]

# Prevent path traversal
# RewriteCond %{REQUEST_URI} \.\.[/\\]
# RewriteRule .* - [F]

# ============================================================
# 11. FIX COMMON ISSUES
# ============================================================

# Fix MIME types
AddType text/html .html .htm
AddType text/css .css
AddType text/javascript .js
AddType application/json .json
AddType image/svg+xml .svg
AddType application/x-font-woff .woff
AddType application/x-font-woff2 .woff2

# Set proper charset
AddDefaultCharset UTF-8

# ============================================================
# 12. ALLOW DIRECT ACCESS TO NECESSARY FILES
# ============================================================

<FilesMatch "\.(html|htm|css|js|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|otf|mp4|webm)$">
    <IfModule mod_rewrite.c>
        RewriteRule ^(.*)$ - [L]
    </IfModule>
</FilesMatch>

# ============================================================
# END CONFIGURATION
# ============================================================
# Last updated: 2026-09-19
# Review and test in staging before production deployment
# ============================================================
